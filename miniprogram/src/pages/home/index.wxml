<view class="page"
  ><view class="row between"
    ><view class="title">{{t.brand}}</view
    ><button class="small" bindtap="account">{{t.account}}</button></view
  ><view class="row"
    ><input
      class="grow"
      placeholder="{{t.search}}"
      value="{{q}}"
      bindinput="input"
      bindconfirm="search"
      confirm-type="search"
    /><button class="primary" bindtap="search" disabled="{{busy}}">
      {{t.find}}
    </button></view
  ><view class="row between toolbar"
    ><view class="row"
      ><button
        class="small {{!mode?'selected':''}}"
        data-location="{{false}}"
        bindtap="mode"
      >
        {{t.items}}</button
      ><button
        class="small {{mode?'selected':''}}"
        data-location="{{true}}"
        bindtap="mode"
      >
        {{t.locations}}
      </button></view
    ><button class="small" bindtap="add">＋ {{t.add}}</button></view
  ><button bindtap="assistant">{{t.assistant}}</button
  ><view wx:if="error" class="error"
    >{{error}}<button bindtap="search">{{t.retry}}</button></view
  ><view class="list"
    ><view
      wx:for="{{items}}"
      wx:key="id"
      class="item"
      data-id="{{item.id}}"
      bindtap="detail"
      ><image
        wx:if="item.photo"
        src="{{item.photo}}"
        mode="aspectFill"
        class="thumb"
      /><view wx:else class="thumb placeholder">{{mode?'⌂':'□'}}</view
      ><view class="grow"
        ><view class="item-name">{{item.name}}</view
        ><view class="muted">{{item.parent.name || t.root}}</view
        ><text wx:for="{{item.tags}}" wx:key="id" wx:for-item="tag" class="tag"
          >{{tag.name}}</text
        ></view
      ></view
    ></view
  ><view wx:if="busy" class="empty">{{t.loading}}</view
  ><view wx:elif="!items.length &amp;&amp; !error" class="empty"
    >{{t.empty}}</view
  ><button wx:if="items.length &lt; total" bindtap="more" disabled="{{busy}}">
    {{t.more}}
  </button></view
>
