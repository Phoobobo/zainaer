<view class="page stack"
  ><view class="title">{{t.account}}</view
  ><view wx:if="error" class="error"
    >{{error}}<button bindtap="load">{{t.retry}}</button></view
  ><text class="muted">{{t.collection}}</text
  ><picker range="{{names}}" value="{{index}}" bindchange="pick"
    ><view class="picker">{{names[index]}}</view></picker
  ><view wx:if="naming" class="stack"
    ><input
      value="{{name}}"
      data-key="name"
      bindinput="input"
      placeholder="{{t.newName}}"
    /><button bindtap="name" disabled="{{busy || !name}}">
      {{t.save}}
    </button></view
  ><input
    value="{{invitation}}"
    data-key="invitation"
    bindinput="input"
    placeholder="{{t.invitation}}"
  /><button bindtap="join" disabled="{{busy || !invitation}}">{{t.join}}</button
  ><button bindtap="language">{{t.language}}</button
  ><button bindtap="logout" disabled="{{busy}}">{{t.logout}}</button></view
>
