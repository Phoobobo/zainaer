[Unit]
Description=Zainaer encrypted online data backup
After=zainaer.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=root
UMask=0077
ExecStart=/usr/bin/python3 /usr/local/lib/zainaer-backup/backup.py /etc/zainaer/backup.json
TimeoutStartSec=45min
Nice=10
IOSchedulingClass=idle
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
